# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Vite only exposes variables prefixed with VITE_ to the browser.
# The publishable key is safe in the browser by design: Row Level Security on
# every table is what actually protects each user's data.
# Find both in Supabase: Project Settings > API.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional. `npm run dev:local` runs with no account and browser storage only,
# for working on the UI. Set automatically by .env.localonly in that mode.
# VITE_LOCAL_ONLY=true
