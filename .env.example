# Copy this file to .env.local and fill in real values. .env.local is gitignored.
# Vite only exposes variables prefixed with VITE_ to the browser.
# These are "anon"/publishable keys — safe in the browser because Row Level
# Security on every table is what actually protects each user's data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
